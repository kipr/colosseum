  {
    "id": "round_subtotal",
    "label": "Round subtotal (Areas 1–9)",
    "type": "calculated",
    "formula": "object_subtotal + zone_1_bonus + zone_2_bonus + zone_3_bonus + zone_4_bonus + zone_5_bonus",
    "column": "left"
  },
  {
    "id": "qualifying_zones",
    "label": "Zones with exactly one smaller duck",
    "type": "calculated",
    "formula": "zone_1_duck + zone_2_duck + zone_3_duck + zone_4_duck + zone_5_duck",
    "column": "left"
  },
  {
    "id": "multiplier",
    "label": "Overall multiplier",
    "type": "calculated",
    "formula": "qualifying_zones < 1 ? 1 : (qualifying_zones > 5 ? 5 : qualifying_zones)",
    "column": "left"
  },
  {
    "id": "grand_total",
    "label": "Total score",
    "type": "calculated",
    "formula": "round_subtotal * multiplier",
    "isGrandTotal": true
  }

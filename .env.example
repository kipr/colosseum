# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Session Secret (change in production!)
SESSION_SECRET=colosseum-secret-key-change-in-production
# Optional session-store tuning for PostgreSQL deployments:
# - disable touch writes to avoid updating the session row on every request
# - prune interval controls expired-session cleanup frequency (seconds)
# SESSION_DISABLE_TOUCH=true
# SESSION_PRUNE_INTERVAL_SECONDS=3600

# Google OAuth Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
# Optional: overrides the callback URL sent to Google OAuth.
# If omitted, derived automatically from APP_URL (or localhost:3000 in dev).
# GOOGLE_CALLBACK_URL=https://your-domain.com/auth/google/callback

# App URL - used for OAuth callback derivation and post-login redirects in production.
# APP_URL=https://your-domain.com

# Optional local PostgreSQL (SQLite remains the default when unset).
# Start Postgres first: npm run db:up && npm run db:wait
# Inside a devcontainer, use hostname postgres instead of localhost.
# DATABASE_URL=postgres://colosseum:colosseum@localhost:5432/colosseum
# TEST_DATABASE_URL=postgres://colosseum:colosseum@localhost:5432/colosseum_test

{
  "name": "colosseum-dev",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.yml"],
  "service": "app",
  "workspaceFolder": "/workspaces/colosseum",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "mounts": [
    "source=${localEnv:HOME}/.config/codex,target=/home/node/.codex,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.serena,target=/home/node/.serena,type=bind,consistency=cached"
  ],
  "forwardPorts": [3000, 5173, 5432],
  "remoteUser": "node",
  "containerEnv": {
    "DATABASE_URL": "postgres://colosseum:colosseum@postgres:5432/colosseum",
    "TEST_DATABASE_URL": "postgres://colosseum:colosseum@postgres:5432/colosseum_test"
  },
  "postCreateCommand": "npm ci",
  "postStartCommand": "sh -c 'until pg_isready -h postgres -U colosseum -d colosseum; do sleep 1; done'"
}
